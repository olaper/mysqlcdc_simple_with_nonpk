# Copy this file to .env and replace every placeholder.
# Ports must be integers between 1 and 65535.
DB='<database-name>'
SRC_HOST='<source-hostname>'
SRC_USER='<source-username>'
SRC_PASSWORD='<source-password>'
SRC_PORT='<source-port>'
DST_HOST='<target-hostname>'
DST_USER='<target-username>'
DST_PASSWORD='<target-password>'
DST_PORT='<target-port>'
